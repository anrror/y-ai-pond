# y-ai-pond — Environment Variables
#
# Copy this file to .env and fill in production values:
#   cp .env.example .env
#
# WARNING: .env contains secrets — NEVER commit it to version control.
# .env is already in .gitignore and .dockerignore.

# ── PostgreSQL (TimescaleDB) ─────────────────────────────────────────────
POSTGRES_USER=pond
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=y-ai-pond

# ── InfluxDB 3 ───────────────────────────────────────────────────────────
INFLUXDB_ORG=y-ai-pond
INFLUXDB_TOKEN=change-me-influxdb-token
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-admin-password

# ── Redis ────────────────────────────────────────────────────────────────
# REDIS_PASSWORD=                  # Uncomment to enable Redis auth

# ── EMQX (MQTT Broker) ──────────────────────────────────────────────────
# EMQX_DASHBOARD__DEFAULT_PASSWORD=change-me  # Uncomment in production

# ── JWT Authentication ───────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ── Gotenberg (PDF Rendering) ────────────────────────────────────────────
# API base URL for server → Gotenberg communication (Docker internal)
GOTENBERG_API_URL=http://gotenberg:3000

# ── ClickHouse (Analytics, optional) ─────────────────────────────────────
# Uncomment if using the analytics profile
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=change-me-clickhouse-password
# CLICKHOUSE_DB=y-ai-pond

# ── Server Configuration ─────────────────────────────────────────────────
# POND_CONFIG=/app/config/config.docker.yaml   # Set via docker-compose.yml
# GIN_MODE=release                             # Set to debug during dev
